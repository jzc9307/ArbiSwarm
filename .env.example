# Optional AI enhancement
GEMINI_API_KEY=
# Backup key (or use GEMINI_API_KEYS=key2,key3 for a larger pool).
# Keys in the same Google project still share quota. Keep keys server-side.
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.8-flash

# Optional third-party Carousell data provider
REEF_API_KEY=

# Optional reliable Shopee keyword-search provider
NEXSCOPE_API_KEY=

# Optional official international marketplace APIs
# eBay production application credentials, with Browse API access
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Etsy application keystring and shared secret (not a Gemini key)
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Business assumptions
MAX_PRICE_MYR=2500
MIN_SELLER_RATING=4.0
PLATFORM_FEE_PCT=0.05
SHIPPING_COST_MYR=8
MIN_MARGIN_PCT_TO_ALERT=20
MAX_SEARCH_RESULTS=12

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
