# Copy settings into your project-root .env; keep your existing private keys.
# Never commit .env. Restart the backend after changing it.
# All credential values below are deliberately blank.

# Optional AI enhancement (required for Lens recognition).
# Preferred roles by slot: manager, evidence analyst, vision, reviewer, chat.
# Roles are software responsibilities; they do not need different credentials.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Optional additional backups; numbered slots come first, duplicates are removed.
GEMINI_API_KEYS=
# Use a model available to your Google project.
GEMINI_MODEL=gemini-3.8-flash
# Only used when the primary MODEL returns 404/410, not on quota errors.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Google PROJECT groups, in the same order as the deduplicated non-empty keys.
# Keys belonging to the SAME project MUST share the same label.
# Example only if all five projects are genuinely independent:
# GEMINI_KEY_PROJECTS=project_a,project_b,project_c,project_d,project_e
# Unknown/unlabelled keys share one conservative local allowance.
GEMINI_KEY_PROJECTS=
# Conservative local request caps PER PROJECT AND MODEL, not extra Google quota.
# Check your own project's current limits; these counters exclude other apps
# and reset on server restart. Use one backend process for this local app.
GEMINI_LOCAL_RPM=5
GEMINI_LOCAL_RPD=20
# Max wire attempts per logical call (including retry/failover).
GEMINI_MAX_ATTEMPTS=2
# Max wire attempts per search; ordinary clear searches normally need one.
AI_OPERATION_BUDGET=3
# One evidence batch reviews at most this many new/changed listings per search.
AI_SHORTLIST_SIZE=8
# Successful evidence cache lifetime in seconds (process memory).
AI_EVIDENCE_TTL=3600

# Optional third-party Carousell data provider
REEF_API_KEY=
REEF_API_BASE=https://api.reefapi.com

# Optional reliable Shopee keyword-search provider
NEXSCOPE_API_KEY=
NEXSCOPE_SHOPEE_URL=https://api.nexscope.ai/api/skill-api/v1/skills/shopee-product-search/run

# Optional official international marketplace APIs
# eBay production application credentials, with Browse API access
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Etsy application keystring and shared secret (not a Gemini key)
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Business assumptions
MAX_PRICE_MYR=2500
MIN_SELLER_RATING=4.0
PLATFORM_FEE_PCT=0.05
SHIPPING_COST_MYR=8
MIN_MARGIN_PCT_TO_ALERT=20
MAX_SEARCH_RESULTS=12

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
